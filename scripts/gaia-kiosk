#!/bin/bash
set -euo pipefail
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/gaia-kiosk-${UID}.lock"
flock -n 9 || exit 0
exec /usr/bin/chromium \
  --user-data-dir="${XDG_CONFIG_HOME:-$HOME/.config}/gaia-kiosk-browser" \
  --kiosk --no-first-run --no-default-browser-check \
  --disable-session-crashed-bubble \
  "file://${GAIA_UI_DIR:-$HOME/Applications/gaia-ui}/index.html"
